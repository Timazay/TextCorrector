<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Основной changelog для таблицы correction_task -->
    <changeSet id="create-correction_tasks-table" author="Зайцев Тимофей">
        <preConditions onFail="HALT">
            <not>
                <tableExists tableName="correction_tasks"/>
            </not>
        </preConditions>

        <!-- Создание таблицы -->
        <createTable tableName="correction_tasks">

            <column name="id" type="UUID">
                <constraints primaryKey="true"
                             primaryKeyName="pk_correction_task"
                             nullable="false"/>
            </column>

            <column name="text" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="language" type="TINYINT">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>